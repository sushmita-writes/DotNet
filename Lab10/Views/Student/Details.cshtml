    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    int i = 1;
}
@model List<StudentModel>;

<h1>Student Details</h1>

<table class="table">
<thead>
	<tr>
		<th>S.N</th>
		<th>ID</th>
		<th>Name</th>
		<th>Grade</th>
	</tr>
</thead>
<tbody>
	@foreach (var student in Model)
	{
		<tr>
			<td>@i</td>
			<td>@student.id</td>
			<td>@student.name</td>
			<td>@student.grade</td>
		</tr>
		i++;
	}
</tbody>
