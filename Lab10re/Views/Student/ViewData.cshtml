@{
    ViewData["Title"] = "Table Data";
}

@model List<StudentModel>
<table class="table">
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Age</th>
        <th>Grade</th>
        <th>PhoneNumber</th>
    </tr>
    @foreach (var row in Model)
    {
        <tr>
            <td>@row.FirstName</td>
            <td>@row.LastName</td>
            <td>@row.Age</td>
            <td>@row.Grade</td>
            <td>@row.PhoneNumber</td>
        </tr>
    }
</table>
